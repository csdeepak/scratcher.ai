{
  "name": "waymark",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual roadmap notebook, editable by you and by any file-editing AI agent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "serve": "tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx src/server/cli.ts validate",
    "gen:large": "tsx scripts/generate-large.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@milkdown/crepe": "^7.23.0",
    "@xyflow/react": "^12.12.1",
    "chokidar": "^6.0.0",
    "cmdk": "^1.1.1",
    "d3-hierarchy": "^3.1.3",
    "diff": "^9.0.0",
    "hono": "^4.13.18",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.73.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-arborist": "^4.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
