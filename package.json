{
  "name": "waymark",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first visual roadmap notebook, editable by you and by any file-editing AI agent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "serve": "tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx src/server/cli.ts validate",
    "qa:a11y": "electron scripts/qa-a11y.cjs",
    "gen:large": "tsx scripts/generate-large.ts",
    "desktop": "vite build && node scripts/build-desktop.mjs && electron .",
    "desktop:build": "vite build && node scripts/build-desktop.mjs",
    "dist:win": "npm run desktop:build && electron-builder --win --publish never",
    "dist:mac": "npm run desktop:build && electron-builder --mac --publish never",
    "dist:linux": "npm run desktop:build && electron-builder --linux --publish never",
    "release:ci": "npm run desktop:build && electron-builder --publish always"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "htmlparser2": "^12.0.0",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "pdfjs-dist": "6.5.438",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@milkdown/crepe": "^7.23.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "axe-core": "^4.10.3",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "d3-hierarchy": "^3.1.3",
    "diff": "^9.0.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.73.0",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-arborist": "^4.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "main": "dist-electron/main.cjs",
  "author": "C S Deepak",
  "homepage": "https://github.com/csdeepak/scratcher.ai",
  "build": {
    "appId": "app.waymark.desktop",
    "productName": "Waymark",
    "copyright": "Copyright © 2026 C S Deepak",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "examples/**",
      "package.json",
      "!**/*.map",
      "!node_modules/tsx/**",
      "!node_modules/esbuild/**",
      "!node_modules/@esbuild/**",
      "!node_modules/get-tsconfig/**",
      "!node_modules/resolve-pkg-maps/**"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Waymark"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "csdeepak",
        "repo": "scratcher.ai",
        "releaseType": "draft"
      }
    ]
  },
  "allowScripts": {
    "electron@45.3.2": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
